{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试当前文件",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/${fileBasenameNoExtension}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "关掉 debuginfod 首次运行的询问",
          "text": "set debuginfod enabled off",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "编译当前文件（不运行）"
    }
  ]
}
