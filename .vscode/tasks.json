{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译并运行当前文件",
      "type": "shell",
      "command": "mkdir -p bin && gcc -Wall -Wextra -g '${file}' -o 'bin/${fileBasenameNoExtension}' && './bin/${fileBasenameNoExtension}'",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}