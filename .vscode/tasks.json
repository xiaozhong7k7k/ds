{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译并运行当前文件",
            "type": "shell",
            "command": "mkdir -p bin && gcc -Wall -Wextra -g '${file}' -o 'bin/${fileBasenameNoExtension}' && './bin/${fileBasenameNoExtension}'",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "编译当前文件（不运行）",
            "type": "shell",
            "command": "mkdir -p bin && gcc -Wall -Wextra -Werror -g '${file}' -o 'bin/${fileBasenameNoExtension}'",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc 生成活动文件",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}